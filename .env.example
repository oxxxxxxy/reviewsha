# Reviewsha local development (copy to .env; never commit real secrets)
NODE_ENV=development

# API
API_HOST=0.0.0.0
API_PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
VITE_API_URL=http://localhost:3000/api/v1

# PostgreSQL / Redis
DATABASE_URL=postgresql://reviewsha:reviewsha@localhost:5432/reviewsha?schema=public
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_PORT=9000
MINIO_ACCESS_KEY=reviewsha
MINIO_SECRET_KEY=reviewsha-password
MINIO_BUCKET_PROJECTS=projects
MINIO_BUCKET_REPORTS=reports
MINIO_BUCKET_TEMP=temp
MINIO_USE_SSL=false

# Authentication (development placeholders only)
JWT_SECRET=change-me-access
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=reviewsha-api
JWT_AUDIENCE=reviewsha-clients
JWT_ALGORITHM=HS256
MAX_SESSIONS_PER_USER=10
INTERNAL_API_KEY=reviewsha-internal-api-key-change-me

# Chat
CHAT_MESSAGE_MAX_LENGTH=4000
CHAT_CONTEXT_MAX_TOKENS=8000
CHAT_REQUEST_TIMEOUT_MS=60000
CHAT_POLL_INTERVAL_MS=100
CHAT_CONTEXT_CACHE_TTL_SECONDS=900

# Worker
WORKER_NAME=reviewsha-worker
WORKER_REDIS_REQUIRED=false
WORKER_CONCURRENCY=3

# AI / OmniRouter
AI_PROVIDER=mock
OMNIROUTER_API_KEY=
OMNIROUTER_BASE_URL=http://localhost:20128/v1
AI_MODEL=auto/best-coding
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.2
AI_TIMEOUT_MS=60000
AI_RETRY_ATTEMPTS=3
AI_RETRY_DELAY_MS=1000
AI_MAX_CONCURRENCY=3
AI_DAILY_REQUEST_LIMIT=500
AI_INPUT_MAX_TOKENS=12000
OMNIROUTE_PORT=20128

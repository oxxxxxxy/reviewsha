{
  "name": "@reviewsha/api",
  "version": "0.0.0",
  "private": true,
  "description": "Reviewsha NestJS API service.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "yarn build:deps && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "yarn build:deps && tsc -p tsconfig.json --noEmit",
    "test": "yarn build:deps && vitest run --coverage=false",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:studio": "prisma studio --browser none",
    "test:watch": "vitest",
    "build:deps": "yarn workspace @reviewsha/config build && yarn workspace @reviewsha/types build && yarn prisma:generate",
    "predev": "yarn build:deps",
    "prisma:format": "prisma format --schema prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "prisma:seed": "prisma db seed --schema prisma/schema.prisma",
    "test:prisma": "vitest run tests/unit/prisma --coverage=false",
    "prisma:reset": "yarn prisma:reset:schema && yarn prisma:seed",
    "prisma:migrate:status": "prisma migrate status --schema prisma/schema.prisma",
    "prisma:reset:schema": "prisma migrate reset --schema prisma/schema.prisma --force",
    "docs:openapi": "yarn build:deps && tsc -p tsconfig.build.json && node dist/swagger/generate-openapi.js",
    "test:stage4": "yarn build:deps && vitest run --config vitest.stage4.coverage.config.mts --coverage",
    "test:stage5": "yarn build:deps && vitest run tests/unit/modules/projects tests/unit/repositories/repositories.test.ts tests/unit/common/auth/authorization.policies.test.ts tests/integration/modules/projects --coverage=false",
    "test:stage6": "yarn build:deps && vitest run tests/unit/modules/storage tests/unit/modules/uploads tests/integration/modules/uploads --coverage=false"
  },
  "dependencies": {
    "@nestjs/common": "^11",
    "@nestjs/config": "^4",
    "@nestjs/core": "^11",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11",
    "@nestjs/swagger": "^11",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@reviewsha/config": "0.0.0",
    "@reviewsha/types": "0.0.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.2.1",
    "minio": "^8.0.6",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "yauzl": "^3.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.4.3",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^2.4.5",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "vitest": "^4.1.10",
    "yazl": "^3.3.1"
  }
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum ProjectRole {
  OWNER
  MAINTAINER
  VIEWER
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum ProjectHistoryAction {
  CREATED
  UPDATED
  ARCHIVED
  RESTORED
  DELETED
  TAG_ADDED
  TAG_REMOVED
}

enum Visibility {
  PRIVATE
  ORGANIZATION
  PUBLIC
}

enum ScanStatus {
  CREATED
  QUEUED
  EXTRACTING
  PARSING
  ANALYZING
  AGGREGATING
  REPORTING
  COMPLETED
  FAILED
  CANCELLED
}

enum ScanStepType {
  UPLOAD
  EXTRACT
  PARSE
  ANALYZE
  REPORT
  CLEANUP
}

enum ScanStepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum Severity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FindingCategory {
  ARCHITECTURE
  BUG
  SECURITY
  PERFORMANCE
  STYLE
  MAINTAINABILITY
  TESTING
}

enum FindingStatus {
  OPEN
  RESOLVED
  IGNORED
}

enum ReportFormat {
  MD
  PDF
  JSON
}

enum AIRequestStatus {
  CREATED
  SENT
  COMPLETED
  FAILED
}

enum QueueStatus {
  WAITING
  ACTIVE
  COMPLETED
  FAILED
  DELAYED
  CANCELLED
}

enum QueueType {
  SCAN
  FILE
  AI
  REPORT
  NOTIFICATION
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum UploadStatus {
  PENDING
  VALIDATING
  UPLOADING
  COMPLETED
  FAILED
  DELETED
}

enum NotificationType {
  SCAN_COMPLETED
  SCAN_FAILED
  REPORT_READY
  SYSTEM
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum RefreshTokenRevokedReason {
  LOGOUT
  LOGOUT_ALL
  ROTATION
  REUSE_DETECTED
  PASSWORD_CHANGED
  ADMIN_REVOKED
  EXPIRED_CLEANUP
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(320)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  displayName  String    @map("display_name") @db.VarChar(120)
  avatarUrl    String?   @map("avatar_url") @db.Text
  role         Role      @default(USER)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  aiRequests         AIRequest[]
  chatMessages       ChatMessage[]
  chatSessions       ChatSession[]
  invitationsSent    Invitation[]     @relation("InvitationInviter")
  notifications      Notification[]
  ownedOrganizations Organization[]   @relation("OrganizationOwner")
  ownedProjects      Project[]        @relation("ProjectOwner")
  projectMemberships ProjectMember[]
  projectHistory     ProjectHistory[]
  refreshTokens      RefreshToken[]
  scans              Scan[]           @relation("ScanCreator")
  sessions           Session[]
  uploadedFiles      UploadedFile[]   @relation("FileUploader")

  @@index([role])
  @@index([isActive])
  @@index([deletedAt])
  @@map("users")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(255)
  device           String?   @db.VarChar(160)
  ip               String?   @db.VarChar(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Organization {
  id        String    @id @default(uuid()) @db.Uuid
  ownerId   String    @map("owner_id") @db.Uuid
  name      String    @db.VarChar(160)
  slug      String    @unique @db.VarChar(120)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  owner       User         @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  invitations Invitation[]
  projects    Project[]

  @@index([ownerId])
  @@index([deletedAt])
  @@map("organizations")
}

model Project {
  id             String        @id @default(uuid()) @db.Uuid
  ownerId        String        @map("owner_id") @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  name           String        @db.VarChar(160)
  description    String?       @db.Text
  language       String?       @db.VarChar(80)
  visibility     Visibility    @default(PRIVATE)
  status         ProjectStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt     DateTime?     @map("archived_at") @db.Timestamptz(3)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(3)

  organization  Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  owner         User             @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  chatSessions  ChatSession[]
  members       ProjectMember[]
  queueJobs     QueueJob[]
  reports       Report[]
  scans         Scan[]
  uploadedFiles UploadedFile[]
  tags          ProjectTag[]
  history       ProjectHistory[]

  @@index([ownerId])
  @@index([organizationId])
  @@index([status])
  @@index([visibility])
  @@index([deletedAt])
  @@map("projects")
}

model ProjectTag {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  name      String   @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([projectId, name])
  @@index([name])
  @@map("project_tags")
}

model ProjectHistory {
  id            String               @id @default(uuid()) @db.Uuid
  projectId     String               @map("project_id") @db.Uuid
  actorId       String               @map("actor_id") @db.Uuid
  action        ProjectHistoryAction
  changedFields Json?                @map("changed_fields")
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  actor   User    @relation(fields: [actorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([projectId, createdAt])
  @@index([actorId])
  @@index([action])
  @@map("project_history")
}

model ProjectMember {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @map("project_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  role      ProjectRole @default(VIEWER)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@index([role])
  @@map("project_members")
}

model UploadedFile {
  id           String       @id @default(uuid()) @db.Uuid
  projectId    String       @map("project_id") @db.Uuid
  uploadedById String?      @map("uploaded_by_id") @db.Uuid
  objectKey    String       @map("object_key") @db.Text
  bucket       String       @db.VarChar(80)
  filename     String       @db.VarChar(255)
  size         BigInt
  mimeType     String       @map("mime_type") @db.VarChar(160)
  checksum     String       @db.VarChar(128)
  status       UploadStatus @default(PENDING)
  version      Int          @default(1)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt    DateTime?    @map("deleted_at") @db.Timestamptz(3)

  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  uploadedBy User?     @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  findings   Finding[]
  scans      Scan[]

  @@unique([bucket, objectKey])
  @@unique([projectId, version])
  @@index([projectId])
  @@index([uploadedById])
  @@index([checksum])
  @@index([deletedAt])
  @@index([projectId, version])
  @@map("uploaded_files")
}

model Scan {
  id           String     @id @default(uuid()) @db.Uuid
  projectId    String     @map("project_id") @db.Uuid
  sourceFileId String?    @map("source_file_id") @db.Uuid
  createdById  String?    @map("created_by_id") @db.Uuid
  status       ScanStatus @default(CREATED)
  progress     Int        @default(0)
  startedAt    DateTime?  @map("started_at") @db.Timestamptz(3)
  finishedAt   DateTime?  @map("finished_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(3)

  createdBy  User?         @relation("ScanCreator", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sourceFile UploadedFile? @relation(fields: [sourceFileId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  aiRequests AIRequest[]
  findings   Finding[]
  queueJobs  QueueJob[]
  report     Report?
  steps      ScanStep[]

  @@index([projectId])
  @@index([sourceFileId])
  @@index([createdById])
  @@index([status])
  @@index([deletedAt])
  @@map("scans")
}

model ScanStep {
  id          String         @id @default(uuid()) @db.Uuid
  scanId      String         @map("scan_id") @db.Uuid
  type        ScanStepType
  status      ScanStepStatus @default(PENDING)
  error       String?        @db.Text
  startedAt   DateTime?      @map("started_at") @db.Timestamptz(3)
  completedAt DateTime?      @map("completed_at") @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([scanId, type])
  @@index([scanId])
  @@index([status])
  @@map("scan_steps")
}

model Report {
  id         String       @id @default(uuid()) @db.Uuid
  scanId     String       @unique @map("scan_id") @db.Uuid
  projectId  String       @map("project_id") @db.Uuid
  summary    String?      @db.Text
  score      Int?
  filePath   String?      @map("file_path") @db.Text
  format     ReportFormat @default(MD)
  tokensUsed Int          @default(0) @map("tokens_used")
  cost       Decimal      @default(0) @db.Decimal(12, 6)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt  DateTime?    @map("deleted_at") @db.Timestamptz(3)

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  scan         Scan          @relation(fields: [scanId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  chatSessions ChatSession[]
  findings     Finding[]

  @@index([scanId])
  @@index([projectId])
  @@index([deletedAt])
  @@map("reports")
}

model Finding {
  id             String          @id @default(uuid()) @db.Uuid
  scanId         String          @map("scan_id") @db.Uuid
  reportId       String?         @map("report_id") @db.Uuid
  fileId         String?         @map("file_id") @db.Uuid
  filePath       String          @map("file_path") @db.Text
  line           Int?
  column         Int?
  lineStart      Int?            @map("line_start")
  lineEnd        Int?            @map("line_end")
  severity       Severity
  category       FindingCategory
  status         FindingStatus   @default(OPEN)
  title          String          @db.VarChar(240)
  description    String          @db.Text
  recommendation String?         @db.Text
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  file       UploadedFile? @relation(fields: [fileId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  report     Report?       @relation(fields: [reportId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  scan       Scan          @relation(fields: [scanId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  aiRequests AIRequest[]

  @@index([scanId])
  @@index([reportId])
  @@index([fileId])
  @@index([severity])
  @@index([category])
  @@index([status])
  @@map("findings")
}

model AIRequest {
  id               String          @id @default(uuid()) @db.Uuid
  scanId           String          @map("scan_id") @db.Uuid
  findingId        String?         @map("finding_id") @db.Uuid
  userId           String?         @map("user_id") @db.Uuid
  provider         String          @db.VarChar(80)
  model            String          @db.VarChar(120)
  promptTokens     Int             @default(0) @map("prompt_tokens")
  completionTokens Int             @default(0) @map("completion_tokens")
  totalTokens      Int             @default(0) @map("total_tokens")
  cost             Decimal         @default(0) @db.Decimal(12, 6)
  status           AIRequestStatus @default(CREATED)
  error            String?         @db.Text
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt      DateTime?       @map("completed_at") @db.Timestamptz(3)

  finding Finding? @relation(fields: [findingId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  scan    Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([scanId])
  @@index([findingId])
  @@index([userId])
  @@index([status])
  @@map("ai_requests")
}

model ChatSession {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  reportId  String?  @map("report_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String?  @db.VarChar(180)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  report   Report?       @relation(fields: [reportId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  messages ChatMessage[]

  @@index([projectId])
  @@index([reportId])
  @@index([userId])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(uuid()) @db.Uuid
  sessionId String      @map("session_id") @db.Uuid
  userId    String?     @map("user_id") @db.Uuid
  role      MessageRole
  content   String      @db.Text
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user    User?       @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([sessionId])
  @@index([userId])
  @@index([role])
  @@map("chat_messages")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  message   String           @db.Text
  read      Boolean          @default(false)
  readAt    DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([read])
  @@index([type])
  @@map("notifications")
}

model Invitation {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  invitedById    String           @map("invited_by_id") @db.Uuid
  email          String           @db.VarChar(320)
  role           ProjectRole      @default(VIEWER)
  status         InvitationStatus @default(PENDING)
  tokenHash      String           @unique @map("token_hash") @db.VarChar(255)
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  acceptedAt     DateTime?        @map("accepted_at") @db.Timestamptz(3)

  invitedBy    User         @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId])
  @@index([invitedById])
  @@index([email])
  @@index([status])
  @@map("invitations")
}

model QueueJob {
  id         String      @id @default(uuid()) @db.Uuid
  projectId  String?     @map("project_id") @db.Uuid
  scanId     String?     @map("scan_id") @db.Uuid
  type       QueueType
  status     QueueStatus @default(WAITING)
  attempts   Int         @default(0)
  workerId   String?     @map("worker_id") @db.VarChar(120)
  payload    Json?
  error      String?     @db.Text
  startedAt  DateTime?   @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime?   @map("finished_at") @db.Timestamptz(3)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  scan    Scan?    @relation(fields: [scanId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([projectId])
  @@index([scanId])
  @@index([status])
  @@index([type])
  @@map("queue_jobs")
}

model RefreshToken {
  id            String                     @id @default(uuid()) @db.Uuid
  userId        String                     @map("user_id") @db.Uuid
  tokenHash     String                     @map("token_hash") @db.VarChar(255)
  jti           String                     @unique @db.VarChar(64)
  userAgent     String?                    @map("user_agent") @db.Text
  ip            String?                    @db.VarChar(64)
  browser       String?                    @db.VarChar(120)
  os            String?                    @db.VarChar(120)
  lastUsedAt    DateTime?                  @map("last_used_at") @db.Timestamptz(3)
  lastIp        String?                    @map("last_ip") @db.VarChar(64)
  lastUserAgent String?                    @map("last_user_agent") @db.Text
  expiresAt     DateTime                   @map("expires_at") @db.Timestamptz(3)
  createdAt     DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt     DateTime?                  @map("revoked_at") @db.Timestamptz(3)
  revokedReason RefreshTokenRevokedReason? @map("revoked_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tokenHash])
  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_tokens")
}

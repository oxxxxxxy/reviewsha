{
  "name": "@reviewsha/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Reviewsha asynchronous worker service.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "yarn build:deps && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "yarn build:deps && tsc -p tsconfig.json --noEmit",
    "test": "yarn build:deps && vitest run --coverage=false",
    "test:watch": "vitest",
    "build:deps": "yarn workspace @reviewsha/config build && yarn workspace @reviewsha/types build",
    "predev": "yarn build:deps"
  },
  "dependencies": {
    "@nestjs/common": "^11",
    "@nestjs/config": "^4",
    "@nestjs/core": "^11",
    "@reviewsha/config": "0.0.0",
    "@reviewsha/types": "0.0.0",
    "bullmq": "^6.0.3",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "vitest": "^4.1.10"
  }
}

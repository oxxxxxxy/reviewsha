{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@reviewsha/ui": ["packages/ui/src/index.ts"],
      "@reviewsha/sdk": ["packages/sdk/src/index.ts"],
      "@reviewsha/types": ["packages/types/src/index.ts"],
      "@reviewsha/config": ["packages/config/src/index.ts"]
    }
  }
}

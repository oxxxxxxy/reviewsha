{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "eslint.useFlatConfig": true,
  "eslint.workingDirectories": [
    { "directory": "apps/api", "changeProcessCWD": false },
    { "directory": "apps/web", "changeProcessCWD": false },
    { "directory": "apps/admin", "changeProcessCWD": false },
    { "directory": "apps/worker", "changeProcessCWD": false },
    { "directory": "packages/config", "changeProcessCWD": false },
    { "directory": "packages/types", "changeProcessCWD": false },
    { "directory": "packages/sdk", "changeProcessCWD": false },
    { "directory": "packages/ui", "changeProcessCWD": false }
  ],
  "typescript.preferences.importModuleSpecifier": "non-relative",
  "typescript.tsdk": "node_modules/typescript/lib",
  "files.eol": "\n"
}
